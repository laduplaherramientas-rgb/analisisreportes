# ============================================================
# 1. AUTH — usuario y contraseña (solo vos)
# ============================================================
# El usuario y contraseña que vas a usar para entrar al sitio.
# NO commits estas variables · van solo en Vercel → Settings → Environment Variables.
AUTH_USER=""
AUTH_PASSWORD=""

# Secreto usado para firmar el cookie de sesión.
# Generá con:  openssl rand -base64 32
AUTH_SECRET=""

# ============================================================
# 2. GOOGLE SHEETS — Service Account (para leer/escribir sheets)
# ============================================================
# Sacar de: https://console.cloud.google.com/iam-admin/serviceaccounts
# 1. Crear service account
# 2. Generar key JSON
# 3. Copiar el JSON completo (una sola línea) acá
# 4. Compartir CADA sheet de cliente + Master Sheet con el email del service account
#    (rol Editor para poder appendear la Bitácora)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ============================================================
# 3. MASTER SHEET — lista de clientes
# ============================================================
# ID del sheet que tiene la pestaña "Clientes" con columnas:
# id | nombre | sheet_id | presupuesto | meta_ventas | moneda | roas_objetivo | color | activo
MASTER_SHEET_ID=""
